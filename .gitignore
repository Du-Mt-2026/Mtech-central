/download/
# Generated PDF analysis
*.analysis.pdf

# === TLS private keys (P0.1 mitigation) ===
# Even though infra/traefik/certs/*.key is already covered by *.key above,
# this explicit rule ensures we never commit Traefik origin keys.
infra/traefik/certs/origin.key
infra/traefik/certs/origin.crt

# === Generated audit documents ===
*.audit.pdf
*.auditoria.pdf

