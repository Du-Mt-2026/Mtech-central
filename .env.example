# ===========================================
# OctupusZap (Mtech-central) — Environment Variables
# ===========================================

# --- REQUIRED ---
# JWT secret for authentication (MUST be set in production!)
# Generate with: openssl rand -hex 32
AUTH_SECRET=your-random-auth-secret-here

# Database connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Evolution API (WhatsApp backend)
EVOLUTION_API_URL=https://your-evolution-api-url
EVOLUTION_API_KEY=your-api-key

# --- OPTIONAL ---
# App URL (used for webhook callbacks and link generation)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Admin credentials (used on first login to auto-create master user)
ADMIN_EMAIL=admin@mtech.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Master

# Cron secret — used by cron-job.org to authenticate requests to /api/campaigns/process-all and /api/sync/linvix
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret-here

# Linvix ERP integration (for Mtech Sync cron job)
# URL of the Linvix ERP instance
LINVIX_URL=https://rp.erp.linvix.com
# Login credentials for the Linvix ERP
LINVIX_USER=Alice
LINVIX_PASS=Linvix2026*

# WireGuard (for proxy-based anti-ban)
WIREGUARD_SERVER_PUB_KEY=your-server-public-key
WIREGUARD_SERVER_PRIV_KEY=your-server-private-key
WIREGUARD_SERVER_ENDPOINT=your-server-ip:51820
WIREGUARD_SUBNET=10.0.0
WIREGUARD_SERVER_PORT=51820
WIREGUARD_API_URL=http://localhost:51820
WIREGUARD_API_TOKEN=your-wireguard-api-token

# Verifier service (optional anti-ban verification)
VERIFIER_SERVICE_URL=http://localhost:3002
