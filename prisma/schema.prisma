generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  relationMode      = "prisma"
}

model Chip {
  id               String   @id @default(cuid())
  name             String
  phoneNumber      String   @unique
  wireguardIp      String   @default("")
  wireguardPrivKey String   @default("")
  wireguardPubKey  String   @default("")
  socksPort        Int      @default(1080)
  status           String   @default("disconnected")
  lastSeen         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contacts         Contact[]
  messages         Message[]
  campaigns        CampaignChip[]
  inboxMessages    InboxMessage[]

  // Anti-ban fields
  dailyLimit       Int      @default(200)
  sentToday        Int      @default(0)
  lastResetAt      DateTime @default(now())
  cooldownUntil    DateTime?
  warmingEnabled   Boolean  @default(true)
  warmingPhase     String   @default("nursery")   // "nursery" (berçário) | "prewarm" (pré-aquecido) | "ready" (pronto)
  warmingStartedAt DateTime?                      // When warming actually started (first send or manual). Null = never sent, always Day 1
  prewarmStartedAt DateTime?                      // When prewarm phase started
  warmingStage     Int      @default(0)            // Legacy compat: 0=new, 5=prewarm, 6=ready
  isQrPaired       Boolean  @default(false)
  qrPairingCode    String?
  proxyMode        String   @default("none")
  socks5Host       String   @default("")
  socks5Port       Int      @default(0)
  socks5User       String   @default("")
  socks5Pass       String   @default("")

  // Evolution API integration
  evolutionInstance         String?  @unique
  profileName              String?
  profilePicUrl            String?
  disconnectionReasonCode  Int?

  // Verification anti-ban fields
  verifiedToday       Int      @default(0)
  lastVerifiedResetAt DateTime @default(now())

  // Hourly limit tracking
  hourlySent          Int      @default(0)
  lastHourlyResetAt   DateTime @default(now())

  // Vendedor association — each chip can belong to a vendedor
  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([evolutionInstance])
}

model AntiBanSettings {
  id                    String   @id @default(cuid())
  typingMinDelay        Int      @default(3000)    // Changed: 3s minimum (was 500ms)
  typingMaxDelay        Int      @default(15000)    // Changed: 15s maximum (was 2000ms)
  messageIntervalMin    Int      @default(30)
  messageIntervalMax    Int      @default(90)
  dailyLimitPerChip     Int      @default(200)
  warmingEnabled        Boolean  @default(true)
  cooldownMinutes       Int      @default(30)
  cooldownMinutesMax    Int      @default(30)      // Cooldown variável: máximo de minutos de pausa (range min-max)
  cooldownAfterMessages Int      @default(50)
  cooldownAfterMessagesMax Int   @default(50)      // Cooldown após N mensagens: máximo (range min-max), ex: 5-10 msgs

  // Break windows — pausas dentro da janela de envio (JSON array)
  // Format: [{"start":720,"end":810,"label":"Almoço"}, {"start":930,"end":960,"label":"Reunião"}]
  // start/end = minutos desde meia-noite (720 = 12:00, 810 = 13:30)
  breakWindows          String   @default("[]")
  stopOnWarning         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // New fields for sending window
  sendingWindowStart    Int      @default(480)     // Minutes from midnight (default 480 = 8:00)
  sendingWindowEnd      Int      @default(1260)    // Minutes from midnight (default 1260 = 21:00)
  timezone              String   @default("America/Sao_Paulo")

  // Editable warming schedules (JSON strings)
  nurserySchedule       String   @default("[{\"dayRange\":\"1-2\",\"days\":[1,2],\"limit\":10},{\"dayRange\":\"3-4\",\"days\":[3,4],\"limit\":20},{\"dayRange\":\"5-6\",\"days\":[5,6],\"limit\":30},{\"dayRange\":\"7-8\",\"days\":[7,8],\"limit\":40},{\"dayRange\":\"9-10\",\"days\":[9,10],\"limit\":50},{\"dayRange\":\"11-12\",\"days\":[11,12],\"limit\":60},{\"dayRange\":\"13-14\",\"days\":[13,14],\"limit\":80}]")
  prewarmSchedule       String   @default("[{\"dayRange\":\"1\",\"days\":[1,1],\"limit\":11},{\"dayRange\":\"2\",\"days\":[2,2],\"limit\":15},{\"dayRange\":\"3\",\"days\":[3,3],\"limit\":20},{\"dayRange\":\"4\",\"days\":[4,4],\"limit\":25},{\"dayRange\":\"5\",\"days\":[5,5],\"limit\":30},{\"dayRange\":\"6\",\"days\":[6,6],\"limit\":35},{\"dayRange\":\"7\",\"days\":[7,7],\"limit\":40},{\"dayRange\":\"8\",\"days\":[8,8],\"limit\":45},{\"dayRange\":\"9\",\"days\":[9,9],\"limit\":50},{\"dayRange\":\"10\",\"days\":[10,10],\"limit\":60},{\"dayRange\":\"11\",\"days\":[11,11],\"limit\":70},{\"dayRange\":\"12\",\"days\":[12,12],\"limit\":80},{\"dayRange\":\"13\",\"days\":[13,13],\"limit\":90},{\"dayRange\":\"14\",\"days\":[14,14],\"limit\":100},{\"dayRange\":\"15\",\"days\":[15,15],\"limit\":120},{\"dayRange\":\"16\",\"days\":[16,16],\"limit\":140},{\"dayRange\":\"17\",\"days\":[17,17],\"limit\":160},{\"dayRange\":\"18\",\"days\":[18,18],\"limit\":180},{\"dayRange\":\"19\",\"days\":[19,19],\"limit\":190},{\"dayRange\":\"20\",\"days\":[20,20],\"limit\":200}]")
  readyDailyLimit       Int      @default(200)     // Phase 3 (Aquecido) daily limit per chip
  hourlyLimit           Int      @default(30)      // Max messages per hour per chip
}

model MessageTemplate {
  id               String   @id @default(cuid())
  name             String
  content          String
  category         String   @default("geral")
  mediatype        String   @default("text")    // text | image | video | audio | document | contact | location | link
  mediaDescription String   @default("")         // Dica de qual mídia anexar (ex: "Foto do monitor 27\"")
  linkUrl          String   @default("")         // URL para tipo link
  linkPreview      Boolean  @default(true)       // Link com visualização?
  steps            String?                       // JSON: array of step objects for multi-step campaign templates
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MessageKey {
  id          String   @id @default(cuid())
  name        String   @unique          // "SAUDACAO_MANHA"
  label       String                    // "Saudação - Bom dia" (nome amigável)
  category    String   @default("geral") // "saudacao", "apresentacao", "pergunta", "encerramento", "emoji", "geral"
  variations  String                     // JSON array: ["Oi, bom dia...", "Olá, tudo bem?...", ...]
  isDefault   Boolean  @default(false)   // Keys pré-definidas do sistema
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?                    // null = global, string = criada por usuário específico
}

model Vendedor {
  id              String   @id @default(cuid())
  nome            String                    // "Renato"
  empresa         String?                   // "Mtech Distribuidora"
  cargo           String?                   // "Gerente de Contas"
  genero          String?                   // "masculino" | "feminino"
  treatAs         String?                   // "o" (sou o Renato) | "a" (sou a Carla)
  whatsapp        String?                   // Número do chip do vendedor (pra receber respostas)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  chips     Chip[]          // Chips associados a este vendedor
  campaigns Campaign[]      // Campanhas atribuídas a este vendedor
}

model ContactList {
  id        String   @id @default(cuid())
  name      String
  columns   String?  @default("{}")  // JSON: {"Empresa":"empresa","Vendedora Responsável":"vendedora_responsável"} — original header → variable key mapping
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts  Contact[]
  campaigns Campaign[]
}

model Contact {
  id            String      @id @default(cuid())
  name          String
  phone         String
  chipId        String?
  chip          Chip?       @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contactListId String?
  contactList   ContactList? @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Dynamic custom fields from spreadsheet (JSON string)
  // Stores all extra columns: empresa, vendedor, nota, etc.
  // Accessed via {{column_name}} in message templates
  customFields      String?    // JSON: {"empresa":"Tech Corp","vendedor":"Renato","nota":"VIP"}
}

model Campaign {
  id               String   @id @default(cuid())
  name             String
  status           String   @default("draft")
  sendIntervalMin  Int      @default(30)
  sendIntervalMax  Int      @default(90)
  contactListId    String?
  contactList      ContactList? @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  chips            CampaignChip[]
  messages         Message[]
  sequenceSteps    SequenceStep[]

  // Anti-ban campaign fields
  antiBanEnabled   Boolean  @default(true)
  warmingMode      String   @default("normal")  // "normal" | "agressive" | "stealth"

  // Status reason — explains why a campaign was paused/stopped (e.g., chip banned, chip disconnected)
  statusReason     String?
  pausedAt         DateTime?

  // Vendedor association — this campaign sends on behalf of this vendedor
  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([status, scheduledAt])
}

model SequenceStep {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder    Int
  content      String
  delayMinutes Int      @default(0)
  delayUnit    String   @default("minutes")  // 'minutes' | 'seconds'
  mediaUrl     String?
  mediatype    String?   // 'image' | 'document' | 'video' | 'audio'
  variations   String   @default("[]")  // JSON: [{content, mediaUrl?, mediatype?}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, stepOrder])
}

model CampaignChip {
  id         String   @id @default(cuid())
  campaignId String
  chipId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chip       Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([campaignId, chipId])
}

model Message {
  id                  String    @id @default(cuid())
  campaignId          String?
  chipId              String
  contactId           String
  content             String
  status              String    @default("pending")
  stepOrder           Int       @default(1)  // Which step in the campaign sequence (1, 2, 3...)
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  error               String?
  evolutionMessageId  String?   @unique
  mediaUrl            String?
  mediatype           String?   // 'image' | 'document' | 'video' | 'audio'
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  chip                Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Prevent duplicate messages: one message per contact per step per campaign
  @@unique([campaignId, contactId, stepOrder])
  @@index([campaignId, status])
  @@index([chipId, status])
  @@index([status])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String   // bcrypt hashed
  role             String   @default("operador") // 'master' | 'admin' | 'operador'
  active           Boolean  @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  imagem           String   @default("")
  isSystemUser     Boolean  @default(false)
  mustChangePassword Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InboxMessage {
  id              String   @id @default(cuid())
  instanceName    String
  chipId          String?
  remoteJid       String
  remotePhone     String   @default("")   // Extracted from remoteJid (without @s.whatsapp.net)
  fromMe          Boolean  @default(false)
  messageContent  String   @db.Text
  messageType     String   @default("text")
  mediaUrl        String?                 // URL da mídia (imagem, vídeo, etc.)
  pushName        String?
  contactName     String?                 // Nome do contato (do pushName ou tabela Contact)
  evolutionMsgId  String?  @unique
  isRead          Boolean  @default(false)
  isGroup         Boolean  @default(false) // Se a mensagem veio de um grupo
  isCampaign      Boolean  @default(false) // Se a mensagem foi enviada por campanha (não é conversa real)
  createdAt       DateTime @default(now())

  chip            Chip?    @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([chipId, remoteJid, createdAt])
  @@index([chipId, isRead])
  @@index([instanceName, createdAt])
  @@index([isCampaign])
}

// ============================================================
// CHIP WARMING (Aquecimento de Chips)
// ============================================================
// Chips novos são "maduros" (aquecidos) antes de irem para operação.
// O processo simula conversas reais entre chips para gerar
// histórico positivo nos servidores do WhatsApp.
//
// Como funciona:
//   1. Seleciona N chips para participar da sessão de aquecimento
//   2. Os chips "conversam entre si" — Chip A manda para Chip B,
//      que responde para Chip C, que manda áudio para Chip A
//   3. Mensagens de texto, imagem e áudio são trocadas
//   4. Tudo com delays gaussianos, presença humanizada, etc.
//   5. Ao final, os chips têm histórico de conversas bidirecionais
//
// Isso reduz drasticamente a chance de ban quando o chip
// começa a operar na esteira de vendas.

model WarmingSession {
  id              String   @id @default(cuid())
  name            String

  // Status: draft | running | paused | completed | cancelled
  status          String   @default("draft")

  // Estratégia de conversação
  // "pairs"      — chips são pareados (A↔B, C↔D)
  // "round_robin" — cada chip fala com o próximo em sequência (A→B→C→A)
  // "random"     — pares aleatórios a cada mensagem
  // "group"      — todos os chips conversam em rotação livre
  strategy        String   @default("round_robin")

  // Pool de chips participantes — JSON array de chip IDs
  // ["chip_id_1", "chip_id_2", ...]
  chipIds         String   @default("[]")

  // Templates de mensagens para o aquecimento
  // JSON array de objetos:
  // [
  //   {
  //     "type": "text"|"image"|"audio",
  //     "content": "Oi, tudo bem?",
  //     "variations": ["Oi, tudo bem?", "E aí, como vai?", "Fala! Tudo certo?"],
  //     "mediaUrl": null,
  //     "caption": null,
  //     "weight": 1.0  // peso relativo (texto=1.0, imagem=0.5, áudio=0.5)
  //   },
  //   {
  //     "type": "image",
  //     "content": "",
  //     "variations": [],
  //     "mediaUrl": "https://example.com/foto.jpg",
  //     "caption": "Olha isso 😄",
  //     "weight": 0.5
  //   }
  // ]
  messageTemplates String  @default("[]")

  // Configuração do aquecimento
  messagesPerChip  Int      @default(150)       // Meta de mensagens por chip (envio + recebimento)
  messagesSent     Int      @default(0)          // Total de mensagens enviadas na sessão
  messagesFailed   Int      @default(0)          // Total de falhas
  intervalMin      Int      @default(45)         // Segundos mínimos entre mensagens (mais conservador que campanhas)
  intervalMax      Int      @default(120)        // Segundos máximos entre mensagens
  activeHoursStart Int      @default(480)        // Início da janela de envio (minutos desde meia-noite, 480=8:00)
  activeHoursEnd   Int      @default(1260)       // Fim da janela de envio (1260=21:00)
  breakWindows     String   @default("[]")       // JSON: [{"start":720,"end":810,"label":"Almoço"}]
  timezone         String   @default("America/Sao_Paulo")

  // Distribuição de tipos de mensagem (percentuais)
  // JSON: {"text": 47, "image": 27, "audio": 26}  → 70+40+40 = 150 por chip
  messageTypeDistribution String @default("{\"text\":47,\"image\":27,\"audio\":26}")

  // Agendamento
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  pausedAt         DateTime?
  lastMessageAt    DateTime?

  // Controle de progresso por chip — JSON
  // {"chip_id_1": {"sent": 30, "received": 28, "lastSentAt": "..."}, ...}
  chipProgress     String   @default("{}")

  // Último par que conversou — para round_robin continuar de onde parou
  // {"lastSenderIdx": 2, "lastRecipientIdx": 5}
  lastPair         String   @default("{}")

  // Erros e diagnóstico
  lastError        String?
  errorCount       Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([status, scheduledAt])
}
