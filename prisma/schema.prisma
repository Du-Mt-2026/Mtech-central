generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  relationMode      = "prisma"
}

model Chip {
  id               String   @id @default(cuid())
  name             String
  phoneNumber      String   @unique
  wireguardIp      String   @default("")
  wireguardPrivKey String   @default("")
  wireguardPubKey  String   @default("")
  socksPort        Int      @default(1080)
  status           String   @default("disconnected")
  lastSeen         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contacts         Contact[]
  messages         Message[]
  campaigns        CampaignChip[]
  inboxMessages    InboxMessage[]
  blockedContacts  BlockedContact[]
  groupMetadata    GroupMetadata[]
  conversations    Conversation[]

  // Anti-ban fields
  dailyLimit       Int      @default(200)
  sentToday        Int      @default(0)
  lastResetAt      DateTime @default(now())
  cooldownUntil    DateTime?
  nextSendAt       DateTime?                     // Anti-ban: próxima vez que este chip pode enviar (persiste intervalo entre invocações serverless)
  warmingEnabled   Boolean  @default(true)
  warmingPhase     String   @default("nursery")   // "nursery" (berçário) | "prewarm" (pré-aquecido) | "ready" (pronto)
  warmingStartedAt DateTime?                      // When warming actually started (first send or manual). Null = never sent, always Day 1
  prewarmStartedAt DateTime?                      // When prewarm phase started
  warmingStage     Int      @default(0)            // Legacy compat: 0=new, 5=prewarm, 6=ready
  isQrPaired       Boolean  @default(false)
  qrPairingCode    String?
  proxyMode        String   @default("none")
  socks5Host       String   @default("")
  socks5Port       Int      @default(0)
  socks5User       String   @default("")
  socks5Pass       String   @default("")

  // Evolution API integration
  evolutionInstance         String?  @unique
  profileName              String?
  profilePicUrl            String?
  disconnectionReasonCode  Int?

  // Verification anti-ban fields
  verifiedToday       Int      @default(0)
  lastVerifiedResetAt DateTime @default(now())

  // Hourly limit tracking
  hourlySent          Int      @default(0)
  lastHourlyResetAt   DateTime @default(now())

  // Pausa individual de chip — quando true, o chip não recebe novas mensagens
  // de campanha, mas continua conectado ao WhatsApp. Mensagens pendentes
  // atribuídas a ele ficam aguardando (não são redistribuídas).
  paused              Boolean  @default(false)
  pausedAt            DateTime?
  pauseReason         String?
  pausedUntil         DateTime?   // Circuit breaker: quando null = pausa manual indefinida; quando preenchido = auto-retoma nesta data

  // Vendedor association — each chip can belong to a vendedor
  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([evolutionInstance])
  @@index([paused, pausedUntil])     // Circuit breaker auto-unpause queries
  @@index([vendedorId])             // Vendedor filter in dashboard
  @@index([warmingPhase, status])   // UI filter for warming chips
}

model AntiBanSettings {
  id                    String   @id @default(cuid())
  typingMinDelay        Int      @default(5100)    // 5.1s minimum typing delay
  typingMaxDelay        Int      @default(24900)   // 24.9s maximum typing delay
  messageIntervalMin    Int      @default(59)      // 59s minimum interval (matches production config)
  messageIntervalMax    Int      @default(148)     // 148s maximum interval (matches production config)
  dailyLimitPerChip     Int      @default(200)
  warmingEnabled        Boolean  @default(true)
  cooldownMinutes       Int      @default(8)       // Cooldown variável: mínimo de minutos de pausa
  cooldownMinutesMax    Int      @default(13)      // Cooldown variável: máximo de minutos de pausa (range min-max)
  cooldownAfterMessages Int      @default(5)       // Cooldown após N mensagens: mínimo
  cooldownAfterMessagesMax Int   @default(9)       // Cooldown após N mensagens: máximo (range min-max)

  // Break windows — pausas dentro da janela de envio (JSON array)
  // Format: [{"start":720,"end":810,"label":"Almoço"}, {"start":930,"end":960,"label":"Reunião"}]
  // start/end = minutos desde meia-noite (720 = 12:00, 810 = 13:30)
  breakWindows          String   @default("[]")
  stopOnWarning         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // New fields for sending window
  sendingWindowStart    Int      @default(540)     // Minutes from midnight (default 540 = 9:00)
  sendingWindowEnd      Int      @default(1020)    // Minutes from midnight (default 1020 = 17:00)
  timezone              String   @default("America/Sao_Paulo")

  // Editable warming schedules (JSON strings)
  nurserySchedule       String   @default("[{\"dayRange\":\"1-2\",\"days\":[1,2],\"limit\":10},{\"dayRange\":\"3-4\",\"days\":[3,4],\"limit\":20},{\"dayRange\":\"5-6\",\"days\":[5,6],\"limit\":30},{\"dayRange\":\"7-8\",\"days\":[7,8],\"limit\":40},{\"dayRange\":\"9-10\",\"days\":[9,10],\"limit\":50},{\"dayRange\":\"11-12\",\"days\":[11,12],\"limit\":60},{\"dayRange\":\"13-14\",\"days\":[13,14],\"limit\":80}]")
  prewarmSchedule       String   @default("[{\"dayRange\":\"1\",\"days\":[1,1],\"limit\":11},{\"dayRange\":\"2\",\"days\":[2,2],\"limit\":15},{\"dayRange\":\"3\",\"days\":[3,3],\"limit\":20},{\"dayRange\":\"4\",\"days\":[4,4],\"limit\":25},{\"dayRange\":\"5\",\"days\":[5,5],\"limit\":30},{\"dayRange\":\"6\",\"days\":[6,6],\"limit\":35},{\"dayRange\":\"7\",\"days\":[7,7],\"limit\":40},{\"dayRange\":\"8\",\"days\":[8,8],\"limit\":45},{\"dayRange\":\"9\",\"days\":[9,9],\"limit\":50},{\"dayRange\":\"10\",\"days\":[10,10],\"limit\":60},{\"dayRange\":\"11\",\"days\":[11,11],\"limit\":70},{\"dayRange\":\"12\",\"days\":[12,12],\"limit\":80},{\"dayRange\":\"13\",\"days\":[13,13],\"limit\":90},{\"dayRange\":\"14\",\"days\":[14,14],\"limit\":100},{\"dayRange\":\"15\",\"days\":[15,15],\"limit\":120},{\"dayRange\":\"16\",\"days\":[16,16],\"limit\":140},{\"dayRange\":\"17\",\"days\":[17,17],\"limit\":160},{\"dayRange\":\"18\",\"days\":[18,18],\"limit\":180},{\"dayRange\":\"19\",\"days\":[19,19],\"limit\":190},{\"dayRange\":\"20\",\"days\":[20,20],\"limit\":200}]")
  readyDailyLimit       Int      @default(200)     // Phase 3 (Aquecido) daily limit per chip
  hourlyLimit           Int      @default(30)      // Max messages per hour per chip
  linkPreviewEnabled    Boolean  @default(false)   // Whether to allow link previews in sent messages (default OFF — link previews in bulk are detectable)

  // Human behavior simulation — makes bot patterns undetectable
  // JSON config with cluster sending, cooldown presence, day rhythm, nonlinear pauses
  humanBehaviorEnabled  Boolean  @default(true)    // Master toggle for human behavior features
  humanBehaviorConfig   String   @default("{\"cluster\":{\"enabled\":true,\"minSize\":2,\"maxSize\":4,\"microPauseMinSec\":10,\"microPauseMaxSec\":25,\"afterClusterPauseMinSec\":59,\"afterClusterPauseMaxSec\":148},\"cooldownPresence\":{\"enabled\":true,\"chancePercent\":40,\"durationMinSec\":5,\"durationMaxSec\":25,\"intervalMinMin\":2,\"intervalMaxMin\":5},\"dayRhythm\":{\"enabled\":true,\"morningFactor\":130,\"middayFactor\":80,\"afternoonFactor\":100},\"nonlinearPauses\":{\"enabled\":true,\"short\":{\"weight\":40,\"minMin\":2,\"maxMin\":5},\"medium\":{\"weight\":40,\"minMin\":8,\"maxMin\":15},\"long\":{\"weight\":20,\"minMin\":20,\"maxMin\":35}},\"typingSimulation\":{\"speedMin\":6,\"speedMax\":14,\"pauseChance\":30,\"pauseMinMs\":1000,\"pauseMaxMs\":4000,\"longMsgThreshold\":100,\"longMsgPauseChance\":40,\"segmentsMin\":2,\"segmentsMax\":3},\"presence\":{\"offlineDelayMinMs\":3000,\"offlineDelayMaxMs\":15000,\"idleReadingChance\":25,\"idleReadingDurationMinMs\":2000,\"idleReadingDurationMaxMs\":8000,\"idleReadingMinIntervalSec\":60,\"preSendOnlineMs\":1000,\"preComposePauseMinMs\":800,\"preComposePauseMaxMs\":3000,\"mediaRecordingMinMs\":2000,\"mediaRecordingMaxMs\":4000},\"deliveryRate\":{\"normalThreshold\":60,\"mediumThreshold\":40,\"mediumMultiplier\":1.5,\"lowThreshold\":20,\"lowMultiplier\":2.5,\"criticalMultiplier\":4.0,\"minSample\":10}}")

  // ============================================================
  // RECONNECTION QUEUE — UI-configurable (was hardcoded in reconnection-queue.ts)
  // ============================================================
  reconnectMaxConcurrent      Int      @default(2)       // Max simultaneous reconnections
  reconnectMaxAttempts        Int      @default(10)      // Max reconnection attempts before giving up
  reconnectRespectWindow      Boolean  @default(false)   // Respect sending window for reconnections
  reconnectRateLimit          Int      @default(5)       // Max reconnections per rate window
  reconnectRateWindowMin      Int      @default(10)      // Rate window in minutes
  reconnectBackoffMs          String   @default("[5000,15000,45000,120000,300000,600000]") // JSON: backoff schedule in ms
  reconnectInterDelayMs       Int      @default(15000)   // Delay between consecutive reconnection starts (ms)
  reconnectConnectTimeoutMs   Int      @default(60000)   // Timeout for chip to connect (ms)
  circuitBreakerThreshold     Int      @default(3)       // Consecutive API failures before circuit breaker opens

  // ============================================================
  // VERIFIER — UI-configurable (was hardcoded in verifier/check/route.ts)
  // ============================================================
  verifyDailyLimit            Int      @default(300)     // Daily verification limit per chip

  // ============================================================
  // EVOLUTION API — UI-configurable (was hardcoded in evolution-api.ts)
  // ============================================================
  evolutionApiTimeoutMs       Int      @default(15000)   // Evolution API request timeout (ms)
  autoRejectCalls             Boolean  @default(true)    // Auto-reject incoming calls
  autoRejectCallMessage       String   @default("Desculpa, não posso atender agora.") // Auto-reject message text

  // ============================================================
  // BAN DETECTION — UI-configurable (was hardcoded in sending-engine.ts + webhook)
  // ============================================================
  banCodes                    String   @default("[401,403,428,440]")       // JSON: disconnection codes indicating ban
  restrictionKeywords         String   @default("[\"sua conta foi banida\",\"sua conta foi suspensa\",\"não está autorizada\",\"violação dos termos\",\"atividade incomum\",\"conta restrita\",\"conta temporariamente suspensa\",\"uso não autorizado\",\"comportamento viola\",\"não está disponível\",\"registro foi removido\",\"encerramos sua conta\",\"sua conta foi desativada\",\"não pode usar este serviço\",\"restrição de segurança\",\"violou nossos termos\"]") // JSON: keywords for temp-ban detection
  warningKeywords            String   @default("[\"aviso\",\"advertência\",\"warn\",\"spam\",\"suspeita\",\"irregular\",\"verificação\",\"confirme\",\"restrição\",\"bloqueio\",\"suspensão\",\"desative\"]") // JSON: keywords for warning detection
  banLookbackHours           Int      @default(24)       // Hours to look back for ban detection
  banKeywordThreshold        Int      @default(2)        // Min keyword matches to trigger ban detection
  banMaxMessagesCheck        Int      @default(50)       // Max recent messages to scan for ban keywords
  warningMaxMessagesCheck    Int      @default(20)       // Max recent messages to scan for warning keywords

  // ============================================================
  // SENDING ENGINE — UI-configurable (was hardcoded in sending-engine.ts)
  // ============================================================
  nurseryMinIntervalSec      Int      @default(120)      // Min interval between sends for nursery chips (sec)
  prewarmMinIntervalSec      Int      @default(60)       // Min interval between sends for prewarm chips (sec)
  functionTimeoutMs          Int      @default(50000)    // Serverless function timeout (ms)
  maxMessagesPerInvocation   Int      @default(10)       // Max messages per execute/process invocation
  minRemainingTimeMs         Int      @default(3000)     // Min remaining time before breaking loop (ms)
  presenceStaggerMinMs       Int      @default(500)      // Min random delay before setting presence (ms)
  presenceStaggerMaxMs       Int      @default(2000)     // Max random delay before setting presence (ms)
  mediaCheckTimeoutMs        Int      @default(5000)     // Timeout for media URL HEAD check (ms)

  // ============================================================
  // VERIFIER EXTENDED — UI-configurable (was hardcoded in verificar-section.tsx)
  // ============================================================
  verifierDelayMin           Int      @default(8)        // Min delay between verification batches (sec)
  verifierDelayMax           Int      @default(15)       // Max delay between verification batches (sec)
  verifierBatchSize          Int      @default(5)        // Numbers per chip per verification round
  verifierCooldownAfter      Int      @default(50)       // Verifications before cooldown
  verifierCooldownMinutes    Int      @default(5)        // Cooldown duration (min)
  verifierQuotaCooldownMs    Int      @default(86400000) // Cooldown when chip quota exhausted (ms)
  verifierRateLimitCooldownMs Int     @default(86400000) // Cooldown after 429 response (ms)
  verifierRateLimitRetryMs   Int      @default(2000)     // Delay after 429 error (ms)

  // ============================================================
  // CAMPAIGN DEFAULTS — UI-configurable (was hardcoded in campaigns/route.ts + page.tsx)
  // ============================================================
  defaultSendIntervalMin     Int      @default(30)       // Default campaign send interval min (sec)
  defaultSendIntervalMax     Int      @default(90)       // Default campaign send interval max (sec)
  defaultAntiBanEnabled      Boolean  @default(true)     // Default anti-ban enabled for new campaigns
  defaultWarmingMode         String   @default("normal") // Default warming mode for new campaigns

  // ============================================================
  // WARMING ENGINE — UI-configurable (was hardcoded in warming-engine.ts)
  // ============================================================
  minChipsForWarming         Int      @default(3)        // Min chips to start a warming session
  warmingAutoPauseErrors     Int      @default(10)       // Error count to auto-pause warming
  warmingErrorRetryMinSec    Int      @default(15)       // Min retry delay after error (sec)
  warmingErrorRetryMaxSec    Int      @default(60)       // Max retry delay after error (sec)
}

model MessageTemplate {
  id               String   @id @default(cuid())
  name             String
  content          String
  category         String   @default("geral")
  mediatype        String   @default("text")    // text | image | video | audio | document | contact | location | link
  mediaDescription String   @default("")         // Dica de qual mídia anexar (ex: "Foto do monitor 27\"")
  linkUrl          String   @default("")         // URL para tipo link
  linkPreview      Boolean  @default(true)       // Link com visualização?
  steps            String?                       // JSON: array of step objects for multi-step campaign templates
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MessageKey {
  id             String   @id @default(cuid())
  name           String   @unique          // "SAUDACAO_MANHA"
  label          String                    // "Saudação - Bom dia" (nome amigável)
  category       String   @default("geral") // "saudacao", "apresentacao", "pergunta", "encerramento", "emoji", "geral"
  variations     String                     // JSON array: ["Oi, bom dia...", "Olá, tudo bem?...", ...]
  resolutionType String   @default("random") // "random" | "time_based"
  timeSlots      String?                    // JSON: [{"key":"BOM_DIA","start":"06:01","end":"12:00"}, ...]
  isDefault      Boolean  @default(false)   // Keys pré-definidas do sistema
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String?                    // null = global, string = criada por usuário específico
}

model Vendedor {
  id              String   @id @default(cuid())
  nome            String                    // "Renato"
  empresa         String?                   // "Mtech Distribuidora"
  cargo           String?                   // "Gerente de Contas"
  genero          String?                   // "masculino" | "feminino"
  treatAs         String?                   // "o" (sou o Renato) | "a" (sou a Carla)
  whatsapp        String?                   // Número do chip do vendedor (pra receber respostas)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  chips     Chip[]          // Chips associados a este vendedor
  campaigns Campaign[]      // Campanhas atribuídas a este vendedor
}

model ContactList {
  id        String   @id @default(cuid())
  name      String
  columns   String?  @default("{}")  // JSON: {"Empresa":"empresa","Vendedora Responsável":"vendedora_responsável"} — original header → variable key mapping
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts  Contact[]
  campaigns Campaign[]
}

model Contact {
  id            String      @id @default(cuid())
  name          String
  phone         String
  position      Int         @default(0)
  chipId        String?
  chip          Chip?       @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contactListId String?
  contactList   ContactList? @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Blocked contact relation (if this contact blocked a chip)
  blockedRecords BlockedContact[]

  // Dynamic custom fields from spreadsheet (JSON string)
  // Stores all extra columns: empresa, vendedor, nota, etc.
  // Accessed via {{column_name}} in message templates
  customFields      String?    // JSON: {"empresa":"Tech Corp","vendedor":"Renato","nota":"VIP"}

  @@index([contactListId, position])  // Contact list queries with ordering
  @@index([chipId])
}

model Campaign {
  id               String   @id @default(cuid())
  name             String
  status           String   @default("draft")
  sendIntervalMin  Int      @default(59)     // Anti-ban safety floor (was 30 — too fast)
  sendIntervalMax  Int      @default(148)    // Anti-ban safety floor (was 90 — too fast)
  contactListId    String?
  contactList      ContactList? @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  chips            CampaignChip[]
  messages         Message[]
  sequenceSteps    SequenceStep[]

  // Anti-ban campaign fields
  antiBanEnabled   Boolean  @default(true)
  warmingMode      String   @default("normal")  // "normal" | "agressive" | "stealth"

  // Status reason — explains why a campaign was paused/stopped (e.g., chip banned, chip disconnected)
  statusReason     String?
  pausedAt         DateTime?
  nextSendAt       DateTime?                     // Anti-ban: próxima vez que esta campanha pode enviar QUALQUER mensagem (persiste intervalo entre invocações serverless)

  // Vendedor association — this campaign sends on behalf of this vendedor
  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([status, scheduledAt])
}

model SequenceStep {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder    Int
  content      String
  delayMinutes Int      @default(0)
  delayUnit    String   @default("minutes")  // 'minutes' | 'seconds'
  mediaUrl     String?
  mediatype    String?   // 'image' | 'document' | 'video' | 'audio'
  variations   String   @default("[]")  // JSON: [{content, mediaUrl?, mediatype?}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, stepOrder])
}

model CampaignChip {
  id           String   @id @default(cuid())
  campaignId   String
  chipId       String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chip         Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())

  // Distribution control — how many contacts this chip should handle in the campaign
  // 0 or null = auto (round-robin equal split), >0 = exact number of contacts assigned
  contactLimit Int?

  @@unique([campaignId, chipId])
}

model Message {
  id                  String    @id @default(cuid())
  campaignId          String?
  chipId              String
  contactId           String
  content             String
  status              String    @default("pending")
  stepOrder           Int       @default(1)  // Which step in the campaign sequence (1, 2, 3...)
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  error               String?
  evolutionMessageId  String?   @unique
  mediaUrl            String?
  mediatype           String?   // 'image' | 'document' | 'video' | 'audio'
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  chip                Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Prevent duplicate messages: one message per contact per step per campaign
  @@unique([campaignId, contactId, stepOrder])
  @@index([campaignId, status])
  @@index([chipId, status])
  @@index([chipId, sentAt])          // Delivery rate queries (recent messages by chip)
  @@index([status])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String   // bcrypt hashed
  role             String   @default("operador") // 'master' | 'admin' | 'operador'
  active           Boolean  @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  imagem           String   @default("")
  isSystemUser     Boolean  @default(false)
  mustChangePassword Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InboxMessage {
  id              String   @id @default(cuid())
  instanceName    String
  chipId          String?
  remoteJid       String
  remotePhone     String   @default("")   // Extracted from remoteJid (without @s.whatsapp.net)
  fromMe          Boolean  @default(false)
  messageContent  String   @db.Text
  messageType     String   @default("text")
  mediaUrl        String?                 // URL da mídia (imagem, vídeo, etc.)
  pushName        String?
  contactName     String?                 // Nome do contato (do pushName ou tabela Contact)
  evolutionMsgId  String?  @unique
  isRead          Boolean  @default(false)
  isGroup         Boolean  @default(false) // Se a mensagem veio de um grupo
  isCampaign      Boolean  @default(false) // Se a mensagem foi enviada por campanha (não é conversa real)
  createdAt       DateTime @default(now())

  // ============================================================
  // DELIVERY RECEIPT TRACKING (Chatwoot-like)
  // ============================================================
  // WhatsApp ack values (from whatsmeow protocol):
  //   0 = PENDING  — message queued, not yet sent
  //   1 = SENT (DEVICE_ACK) — sent from device to WhatsApp server
  //   2 = RECEIVED (SERVER_ACK) — received by WhatsApp server
  //   3 = DELIVERED — delivered to recipient's device (double tick ✓✓)
  //   4 = READ — read by recipient (blue ticks ✓✓)
  //   5 = PLAYED — played (audio/video)
  //
  // Status is MONOTONIC — only upgrades, never downgrades.
  // This prevents race conditions where "delivered" arrives before "sent".
  ack             Int      @default(0)     // Raw ack value from Evolution API (0-5)
  status          String   @default("pending")  // "pending" | "sent" | "delivered" | "read" | "failed"
  deliveredAt     DateTime?                     // When the message was delivered (double tick)
  readAt          DateTime?                     // When the message was read (blue tick)

  // ============================================================
  // QUOTED MESSAGE / REPLY (Chatwoot-like content_attributes)
  // ============================================================
  // When someone replies to a message, WhatsApp includes contextInfo
  // with the original message's stanzaId. We store a reference so
  // the UI can render the quoted message preview (WhatsApp-style).
  quotedMsgId     String?                       // evolutionMsgId of the message being replied to
  quotedContent   String?  @db.Text             // Preview text of the quoted message (for quick display)
  quotedType      String?                       // Type of quoted message (text, image, etc.)
  quotedPushName  String?                       // pushName of the sender of the quoted message

  // ============================================================
  // REACTIONS (WhatsApp-style emoji reactions)
  // ============================================================
  // Reactions are stored on the ORIGINAL message, not as separate messages.
  // When we receive a reactionMessage, we find the target message and
  // add the emoji to its reactionEmoji field.
  // Format: JSON array of { "emoji": "👍", "from": "pushName", "fromJid": "remoteJid" }
  reactionEmoji   String?                       // JSON array of reaction objects

  // ============================================================
  // ENRICHED MEDIA METADATA
  // ============================================================
  fileName        String?                       // Original file name for documents
  mimeType        String?                       // MIME type of media
  mediaCaption    String?  @db.Text             // Caption separate from messageContent (for images/videos)
  mediaDuration   Int?                          // Duration in seconds (for audio/video)

  chip            Chip?    @relation(fields: [chipId], references: [id], onDelete: Cascade)

  // v2.1: Link to Conversation (Chatwoot-like) — null for old messages before migration
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([chipId, remoteJid, createdAt])
  @@index([chipId, isRead])
  @@index([instanceName, createdAt])
  @@index([isCampaign])
  @@index([status])                    // For delivery rate queries
  @@index([evolutionMsgId])            // For fast ack updates from webhook
}

// ============================================================
// GROUP METADATA CACHE
// ============================================================
// Caches group names (subjects) to avoid N+1 API calls on every
// conversation list load. The webhook updates this when group
// info changes, and the conversations API reads from cache.
//
// This follows Chatwoot's pattern of storing group info as
// Contact metadata, but in a dedicated table for efficiency.
model GroupMetadata {
  id              String   @id @default(cuid())
  groupJid        String   @unique             // Full JID: 123456789-1234567890@g.us
  subject         String                       // Group name (social name)
  subjectOwner    String?                      // JID of who set the name
  subjectAt       DateTime?                    // When the name was last changed
  participantCount Int     @default(0)          // Number of participants
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Link to chip — group metadata is per-chip because different
  // chips may see different group info (e.g., if one was removed)
  chipId          String?
  chip            Chip?    @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([chipId])
  @@index([subject])                // For search
}

// ============================================================
// CONVERSATION MODEL (Chatwoot-like)
// ============================================================
// Replaces the runtime grouping of InboxMessages by remoteJid.
// Each conversation is a persistent entity with its own metadata,
// status, and assignee — following Chatwoot's 4-level hierarchy:
//   Account → Inbox (Chip) → Conversation → Message (InboxMessage)
//
// This enables:
//   - Fast conversation list queries (no runtime aggregation)
//   - Conversation status management (open/resolved/pending)
//   - Agent assignment and routing
//   - Real-time conversation updates via WebSocket
model Conversation {
  id              String   @id @default(cuid())
  chipId          String                            // FK to Chip (= Inbox in Chatwoot)
  remoteJid       String                            // WhatsApp JID (phone@s.whatsapp.net or group@g.us)
  remotePhone     String   @default("")             // Extracted phone number
  contactName     String?                           // Display name (contact or group)
  pushName        String?                           // WhatsApp push name
  groupName       String?                           // Group subject (official/social name)
  isGroup         Boolean  @default(false)          // Whether this is a group conversation
  isArchived      Boolean  @default(false)          // Soft archive (WhatsApp archive or manual)

  // Chatwoot-like conversation status
  status          String   @default("open")         // "open" | "resolved" | "pending" | "snoozed"

  // Last activity tracking (for conversation list sorting)
  lastMessageAt   DateTime @default(now())          // Timestamp of last message
  lastMessagePreview String? @db.Text               // Preview text of last message
  lastMessageType String?                           // Type of last message
  lastMessageFromMe Boolean @default(false)         // Whether last message was from us
  lastMessageStatus String?                         // Status of last message (for check marks)

  // Unread tracking
  unreadCount     Int      @default(0)              // Number of unread incoming messages

  // Contact metadata (cached for fast list queries)
  profilePicUrl   String?                           // Contact profile picture URL
  participantCount Int?                             // Group participant count

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  chip            Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)
  messages        InboxMessage[]                    // Messages in this conversation

  @@unique([chipId, remoteJid])                    // One conversation per chip+contact
  @@index([chipId, lastMessageAt])                 // For sorted conversation list queries
  @@index([chipId, status])                        // For filtering by status
  @@index([isArchived])
}

// ============================================================
// CHIP WARMING (Aquecimento de Chips)
// ============================================================
// Chips novos são "maduros" (aquecidos) antes de irem para operação.
// O processo simula conversas reais entre chips para gerar
// histórico positivo nos servidores do WhatsApp.
//
// Como funciona:
//   1. Seleciona N chips para participar da sessão de aquecimento
//   2. Os chips "conversam entre si" — Chip A manda para Chip B,
//      que responde para Chip C, que manda áudio para Chip A
//   3. Mensagens de texto, imagem e áudio são trocadas
//   4. Tudo com delays gaussianos, presença humanizada, etc.
//   5. Ao final, os chips têm histórico de conversas bidirecionais
//
// Isso reduz drasticamente a chance de ban quando o chip
// começa a operar na esteira de vendas.

model WarmingSession {
  id              String   @id @default(cuid())
  name            String

  // Status: draft | running | paused | completed | cancelled
  status          String   @default("draft")

  // Estratégia de conversação
  // "pairs"      — chips são pareados (A↔B, C↔D)
  // "round_robin" — cada chip fala com o próximo em sequência (A→B→C→A)
  // "random"     — pares aleatórios a cada mensagem
  // "group"      — todos os chips conversam em rotação livre
  strategy        String   @default("round_robin")

  // Pool de chips participantes — JSON array de chip IDs
  // ["chip_id_1", "chip_id_2", ...]
  chipIds         String   @default("[]")

  // Templates de mensagens para o aquecimento
  // JSON array de objetos:
  // [
  //   {
  //     "type": "text"|"image"|"audio",
  //     "content": "Oi, tudo bem?",
  //     "variations": ["Oi, tudo bem?", "E aí, como vai?", "Fala! Tudo certo?"],
  //     "mediaUrl": null,
  //     "caption": null,
  //     "weight": 1.0  // peso relativo (texto=1.0, imagem=0.5, áudio=0.5)
  //   },
  //   {
  //     "type": "image",
  //     "content": "",
  //     "variations": [],
  //     "mediaUrl": "https://example.com/foto.jpg",
  //     "caption": "Olha isso 😄",
  //     "weight": 0.5
  //   }
  // ]
  messageTemplates String  @default("[]")

  // Configuração do aquecimento
  messagesPerChip  Int      @default(150)       // Meta de mensagens por chip (envio + recebimento)
  messagesSent     Int      @default(0)          // Total de mensagens enviadas na sessão
  messagesFailed   Int      @default(0)          // Total de falhas
  intervalMin      Int      @default(45)         // Segundos mínimos entre mensagens (mais conservador que campanhas)
  intervalMax      Int      @default(120)        // Segundos máximos entre mensagens
  activeHoursStart Int      @default(480)        // Início da janela de envio (minutos desde meia-noite, 480=8:00)
  activeHoursEnd   Int      @default(1260)       // Fim da janela de envio (1260=21:00)
  breakWindows     String   @default("[]")       // JSON: [{"start":720,"end":810,"label":"Almoço"}]
  timezone         String   @default("America/Sao_Paulo")

  // Distribuição de tipos de mensagem (percentuais)
  // JSON: {"text": 47, "image": 27, "audio": 26}  → 70+40+40 = 150 por chip
  messageTypeDistribution String @default("{\"text\":47,\"image\":27,\"audio\":26}")

  // Agendamento
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  pausedAt         DateTime?
  lastMessageAt    DateTime?

  // Controle de progresso por chip — JSON
  // {"chip_id_1": {"sent": 30, "received": 28, "lastSentAt": "..."}, ...}
  chipProgress     String   @default("{}")

  // Último par que conversou — para round_robin continuar de onde parou
  // {"lastSenderIdx": 2, "lastRecipientIdx": 5}
  lastPair         String   @default("{}")

  // Erros e diagnóstico
  lastError        String?
  errorCount       Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([status, scheduledAt])
}

// ============================================================
// BLOCKED CONTACTS (Contatos Bloqueados)
// ============================================================
// Contatos que provavelmente bloquearam o número do chip.
// Detectados automaticamente quando mensagens ficam em status
// 'sent' (não entregues) por mais de 48h.
//
// O sending engine PULA esses contatos automaticamente,
// evitando mandar pra quem já bloqueou (risco de ban).
//
// O usuário pode desbloquear manualmente se for falso positivo
// (ex: telefone desligado por muitos dias por bateria).

model BlockedContact {
  id            String   @id @default(cuid())
  chipId        String                            // Chip que tentou enviar
  chip          Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contactPhone  String                            // Phone number of blocked contact (for quick lookup)
  contactId     String?                           // Optional link to Contact record
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Detection details
  reason        String   @default("undelivered")  // "undelivered" | "manual" | "profile_pic_gone"
  confidence    String   @default("medium")       // "low" | "medium" | "high"
  undeliveredCount Int   @default(0)              // How many messages were never delivered to this contact
  lastSentAt    DateTime?                         // When the last undelivered message was sent
  detectedAt    DateTime  @default(now())         // When we detected the block

  // User management
  autoBlocked   Boolean  @default(true)           // true = detected by system, false = manual
  unblockedAt   DateTime?                         // When user manually unblocked
  unblockReason String?                           // Why user unblocked (e.g., "false positive — battery was dead")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([chipId, contactPhone])                // One block record per chip+phone
  @@index([chipId])
  @@index([contactPhone])
  @@index([unblockedAt])                          // Filter active blocks (unblockedAt = null)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  userRole  String?
  action    String
  category  String   @default("general")
  targetId  String?
  targetType String?
  details   Json?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([category])
  @@index([targetType, targetId])
  @@index([userId])
}
