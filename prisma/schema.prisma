generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  relationMode      = "prisma"
}

model Chip {
  id               String   @id @default(cuid())
  name             String
  phoneNumber      String   @unique
  wireguardIp      String   @default("")
  wireguardPrivKey String   @default("")
  wireguardPubKey  String   @default("")
  socksPort        Int      @default(1080)
  status           String   @default("disconnected")
  lastSeen         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contacts         Contact[]
  messages         Message[]
  campaigns        CampaignChip[]

  // Anti-ban fields
  dailyLimit       Int      @default(200)
  sentToday        Int      @default(0)
  lastResetAt      DateTime @default(now())
  cooldownUntil    DateTime?
  warmingEnabled   Boolean  @default(true)
  warmingPhase     String   @default("nursery")   // "nursery" (berçário) | "prewarm" (pré-aquecido) | "ready" (pronto)
  prewarmStartedAt DateTime?                      // When prewarm phase started
  // warmingStage kept for backward compat, but new logic uses warmingPhase + daysSinceCreation
  isQrPaired       Boolean  @default(false)
  qrPairingCode    String?
  proxyMode        String   @default("none")
  socks5Host       String   @default("")
  socks5Port       Int      @default(0)
  socks5User       String   @default("")
  socks5Pass       String   @default("")

  // Evolution API integration
  evolutionInstance         String?  @unique
  profileName              String?
  profilePicUrl            String?
  disconnectionReasonCode  Int?

  // Verification anti-ban fields
  verifiedToday       Int      @default(0)
  lastVerifiedResetAt DateTime @default(now())

  // Vendedor association — each chip can belong to a vendedor
  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
}

model AntiBanSettings {
  id                    String   @id @default(cuid())
  typingMinDelay        Int      @default(3000)    // Changed: 3s minimum (was 500ms)
  typingMaxDelay        Int      @default(15000)    // Changed: 15s maximum (was 2000ms)
  messageIntervalMin    Int      @default(30)
  messageIntervalMax    Int      @default(90)
  randomLineBreaks      Boolean  @default(true)
  emojiVariation        Boolean  @default(true)
  dailyLimitPerChip     Int      @default(200)
  warmingEnabled        Boolean  @default(true)
  warmingDays           Int      @default(7)
  cooldownMinutes       Int      @default(30)
  cooldownAfterMessages Int      @default(50)
  stopOnWarning         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // New fields for sending window
  sendingWindowStart    Int      @default(480)     // Minutes from midnight (default 480 = 8:00)
  sendingWindowEnd      Int      @default(1260)    // Minutes from midnight (default 1260 = 21:00)
  timezone              String   @default("America/Sao_Paulo")
}

model MessageTemplate {
  id               String   @id @default(cuid())
  name             String
  content          String
  category         String   @default("geral")
  mediatype        String   @default("text")    // text | image | video | audio | document | contact | location | link
  mediaDescription String   @default("")         // Dica de qual mídia anexar (ex: "Foto do monitor 27\"")
  linkUrl          String   @default("")         // URL para tipo link
  linkPreview      Boolean  @default(true)       // Link com visualização?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MessageKey {
  id          String   @id @default(cuid())
  name        String   @unique          // "SAUDACAO_MANHA"
  label       String                    // "Saudação - Bom dia" (nome amigável)
  category    String   @default("geral") // "saudacao", "apresentacao", "pergunta", "encerramento", "emoji", "geral"
  variations  String                     // JSON array: ["Oi, bom dia...", "Olá, tudo bem?...", ...]
  isDefault   Boolean  @default(false)   // Keys pré-definidas do sistema
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?                    // null = global, string = criada por usuário específico
}

model Vendedor {
  id              String   @id @default(cuid())
  nome            String                    // "Renato"
  empresa         String?                   // "Mtech Distribuidora"
  cargo           String?                   // "Gerente de Contas"
  genero          String?                   // "masculino" | "feminino"
  treatAs         String?                   // "o" (sou o Renato) | "a" (sou a Carla)
  whatsapp        String?                   // Número do chip do vendedor (pra receber respostas)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  chips     Chip[]          // Chips associados a este vendedor
  campaigns Campaign[]      // Campanhas atribuídas a este vendedor
}

model ContactList {
  id        String   @id @default(cuid())
  name      String
  columns   String?  @default("{}")  // JSON: {"Empresa":"empresa","Vendedora Responsável":"vendedora_responsável"} — original header → variable key mapping
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts  Contact[]
  campaigns Campaign[]
}

model Contact {
  id            String      @id @default(cuid())
  name          String
  phone         String
  chipId        String?
  chip          Chip?       @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contactListId String?
  contactList   ContactList? @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Dynamic custom fields from spreadsheet (JSON string)
  // Stores all extra columns: empresa, vendedor, nota, etc.
  // Accessed via {{column_name}} in message templates
  customFields      String?    // JSON: {"empresa":"Tech Corp","vendedor":"Renato","nota":"VIP"}
}

model Campaign {
  id               String   @id @default(cuid())
  name             String
  status           String   @default("draft")
  sendIntervalMin  Int      @default(30)
  sendIntervalMax  Int      @default(90)
  contactListId    String?
  contactList      ContactList? @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  chips            CampaignChip[]
  messages         Message[]
  sequenceSteps    SequenceStep[]

  // Anti-ban campaign fields
  antiBanEnabled   Boolean  @default(true)
  warmingMode      String   @default("normal")  // "normal" | "agressive" | "stealth"

  // Vendedor association — this campaign sends on behalf of this vendedor
  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
}

model SequenceStep {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder    Int
  content      String
  delayMinutes Int      @default(0)
  mediaUrl     String?
  mediatype    String?   // 'image' | 'document' | 'video' | 'audio'
  variations   String   @default("[]")  // JSON: [{content, mediaUrl?, mediatype?}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, stepOrder])
}

model CampaignChip {
  id         String   @id @default(cuid())
  campaignId String
  chipId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  chip       Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([campaignId, chipId])
}

model Message {
  id                  String    @id @default(cuid())
  campaignId          String?
  chipId              String
  contactId           String
  content             String
  status              String    @default("pending")
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  error               String?
  evolutionMessageId  String?   @unique
  mediaUrl            String?
  mediatype           String?   // 'image' | 'document' | 'video' | 'audio'
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  chip                Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)
  contact             Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String   // bcrypt hashed
  role             String   @default("operador") // 'master' | 'admin' | 'operador'
  active           Boolean  @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  imagem           String   @default("")
  isSystemUser     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InboxMessage {
  id              String   @id @default(cuid())
  instanceName    String
  remoteJid       String
  fromMe          Boolean  @default(false)
  messageContent  String   @db.Text
  messageType     String   @default("text")
  pushName        String?
  evolutionMsgId  String?  @unique
  createdAt       DateTime @default(now())
}
