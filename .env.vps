# ============================================
# OctupusZap - Configuração para VPS
# ============================================
# Copie este arquivo para .env e ajuste os valores!
# Este arquivo é para REFERÊNCIA — o deploy.sh gera o .env automaticamente.

# === Domínio ===
# O subdomínio que vai apontar para a VPS (ex: octupuszap.nikki.com.br)
APP_DOMAIN=octupuszap.seudominio.com
APP_PUBLIC_URL=https://octupuszap.seudominio.com

# === Banco de Dados ===
# Senha do PostgreSQL local (dentro do Docker)
DB_PASSWORD=octupuszap123

# === Evolution API Go ===
# URL interna do Evolution Go na rede Docker (hostname do container)
EVOLUTION_API_URL=http://evolution-go:8080
# Chave de API global do Evolution Go
EVOLUTION_API_KEY=sua-api-key-aqui

# === Autenticação ===
# Segredo para sessões JWT (gere um novo com: openssl rand -base64 32)
AUTH_SECRET=mude-para-uma-chave-aleatoria

# === Cron Secret ===
# Segredo para autenticar chamadas dos cron containers
# (gere com: openssl rand -hex 16)
CRON_SECRET=mude-para-um-secret-aleatorio

# === Traefik ===
# Nome da rede Docker do Traefik (descubra com: docker network ls | grep traefik)
TRAEFIK_NETWORK=duda-bot_duda-network

# === Admin Padrão ===
# Usado no primeiro login para criar o usuário master
ADMIN_EMAIL=admin@mtech.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Master

# === Opcional: Linvix ERP ===
# LINVIX_URL=https://rp.erp.linvix.com
# LINVIX_USER=Alice
# LINVIX_PASS=Linvix2026*

# === Opcional: WireGuard (proxy anti-ban) ===
# WIREGUARD_SERVER_PUB_KEY=your-server-public-key
# WIREGUARD_SERVER_PRIV_KEY=your-server-private-key
# WIREGUARD_SERVER_ENDPOINT=your-server-ip:51820
# WIREGUARD_SUBNET=10.0.0
# WIREGUARD_SERVER_PORT=51820
# WIREGUARD_CHIP_IP_START=100
# WIREGUARD_API_URL=http://10.0.0.1:51821
# WIREGUARD_API_TOKEN=your-wireguard-api-token

# === Opcional: Verifier ===
# VERIFIER_SERVICE_URL=http://localhost:3002
