# Evolution Go Environment Configuration
# Copy this file to evolution-go.env and fill in real values
# NEVER commit evolution-go.env with real secrets

SERVER_PORT=8080
CLIENT_NAME=evolution
GLOBAL_API_KEY=YOUR_GLOBAL_API_KEY_HERE

# PgBouncer connection (porta 6432) — NÃO conectar direto no Postgres (5432)
POSTGRES_AUTH_DB=postgresql://postgres:YOUR_PASSWORD@10.0.0.1:6432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:YOUR_PASSWORD@10.0.0.1:6432/evogo_users?sslmode=disable

DATABASE_SAVE_MESSAGES=false
WADEBUG=DEBUG
LOGTYPE=console
CONNECT_ON_STARTUP=true
WEBHOOK_FILES=true
AMQP_URL=amqp://admin:YOUR_PASSWORD@10.0.0.1:5672
AMQP_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=https://your-domain.com/webhooks/whatsapp
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=true

# Prevent forced logout that destroys sessions
QRCODE_MAX_COUNT=999
